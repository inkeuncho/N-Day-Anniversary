{
  "mcpServers": {
    "shrimp-task-manager": {
      "command": "node",
      "args": ["/home/user/mcp-shrimp-task-manager/dist/index.js"],
      "env": {
        "DATA_DIR": "/home/user/shrimp_data",
        "TEMPLATES_USE": "en",
        "ENABLE_GUI": "false"
      }
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    }
  }
}
